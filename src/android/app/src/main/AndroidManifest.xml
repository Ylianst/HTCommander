<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Bluetooth permissions for flutter_blue_plus -->
    <!-- Android 12+ (API 31+) permissions -->
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <!-- Legacy permissions for Android < 12 -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
    <!-- Location permission required for BLE scanning on some devices -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- Internet permission required for network access (Winlink/Dump1090) -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Required by SpeechRecognizer even when audio is fed via a file
         descriptor (EXTRA_AUDIO_SOURCE) rather than the microphone. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Show pop-up notifications for incoming messages (Android 13+). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Declares that the app hosts an Android for Cars App Library (Android
         Auto) experience. Optional so phones without a car host still install. -->
    <uses-feature
        android:name="android.software.car.templates_host"
        android:required="false" />

    <application
        android:label="HTCommander"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:localeConfig="@xml/locales_config">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />

        <!-- Android for Cars App Library: minimum car API level required. -->
        <meta-data
            android:name="androidx.car.app.minCarApiLevel"
            android:value="1" />
        <meta-data
            android:name="com.google.android.gms.car.application"
            android:resource="@xml/automotive_app_desc" />

        <!-- Android Auto car UI entry point (templated). The IOT category lets
             the app appear on phone-projected Android Auto as a device control
             app. See RadioCarAppService / RadioChannelsScreen. -->
        <service
            android:name=".RadioCarAppService"
            android:exported="true">
            <intent-filter>
                <action android:name="androidx.car.app.CarAppService" />
                <category android:name="androidx.car.app.category.IOT" />
            </intent-filter>
        </service>

        <!-- Enables androidx.appcompat locale persistence so the per-app language
             picker works on Android 12 and below (API < 33). -->
        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- Required to discover and bind the on-device speech recognizer used
             by AndroidSpeechToTextPlugin (SpeechRecognizer) on Android 11+. -->
        <intent>
            <action android:name="android.speech.RecognitionService"/>
        </intent>
    </queries>
</manifest>
